# dev | production
VITE_APP_ENV=dev

# Platform display name
VITE_APP_TITLE=校园任务平台

# Frontend public URL (for deployment consistency)
VITE_FRONTEND_PUBLIC_URL_DEV=http://localhost:5173
VITE_FRONTEND_PUBLIC_URL_PROD=https://app.example.com

# Backend API URL by mode
VITE_API_BASE_URL_DEV=http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL_PROD=https://api.example.com/api/v1

# Optional explicit override (highest priority)
VITE_API_BASE_URL=
