APP_NAME=Campus Task Platform API
# dev | production
ENV=dev
# log level is derived from ENV:
# - dev/development/local => DEBUG
# - production/prod => INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./campus_task.db
REDIS_URL=redis://127.0.0.1:6379
AGENT_QUEUE_KEY_PREFIX=campus_task:agent_queue

# Agent gateway settings. Leave AGENT_GATEWAY_PUBLIC_BASE_URL empty to derive
# from BACKEND_PUBLIC_URL_* automatically. In development, localhost/127.0.0.1
# will be rewritten to host.docker.internal for the agent container.
AGENT_GATEWAY_PUBLIC_BASE_URL=
AGENT_GATEWAY_TIMEOUT_SECONDS=600
AGENT_GATEWAY_TOKEN_EXPIRE_MINUTES=120
AGENT_RUN_SILENCE_TIMEOUT_SECONDS=300
AGENT_RUN_MAX_SECONDS=1800

# Upstream credentials stay in backend/.env only. Never place them in backend/agent/.env.
AGENT_UPSTREAM_KIMI_API_KEY=your_kimi_api_key_here
AGENT_UPSTREAM_KIMI_BASE_URL=https://api.kimi.com/coding/v1
# Optional overrides when search/fetch use dedicated URLs.
# AGENT_UPSTREAM_KIMI_SEARCH_URL=https://api.kimi.com/coding/v1/search
# AGENT_UPSTREAM_KIMI_FETCH_URL=https://api.kimi.com/coding/v1/fetch

# Public URLs by environment
BACKEND_PUBLIC_URL_DEV=http://127.0.0.1:8000
BACKEND_PUBLIC_URL_PROD=https://api.example.com
FRONTEND_PUBLIC_URL_DEV=http://localhost:5173
FRONTEND_PUBLIC_URL_PROD=https://app.example.com

# Optional CORS override (comma-separated).
# Leave empty to auto-select by ENV:
# - dev: localhost/127.0.0.1 common vite origins
# - production: FRONTEND_PUBLIC_URL_PROD only
CORS_ORIGINS=

THIRD_PARTY_AUTH_URL=http://127.0.0.1:9000/mock-auth
PASSWORD_ENCRYPTION=true
REGISTRATION_DEFAULT_ENABLED=true

ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=admin123456
