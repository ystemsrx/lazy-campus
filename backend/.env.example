APP_NAME=Campus Task Platform API
# dev | production
ENV=dev
# log level is derived from ENV:
# - dev/development/local => DEBUG
# - production/prod => INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./campus_task.db

# Public URLs by environment
BACKEND_PUBLIC_URL_DEV=http://127.0.0.1:8000
BACKEND_PUBLIC_URL_PROD=https://api.example.com
FRONTEND_PUBLIC_URL_DEV=http://localhost:5173
FRONTEND_PUBLIC_URL_PROD=https://app.example.com

# Optional CORS override (comma-separated).
# Leave empty to auto-select by ENV:
# - dev: localhost/127.0.0.1 common vite origins
# - production: FRONTEND_PUBLIC_URL_PROD only
CORS_ORIGINS=

THIRD_PARTY_AUTH_URL=http://127.0.0.1:9000/mock-auth
PASSWORD_ENCRYPTION=true
REGISTRATION_DEFAULT_ENABLED=true

ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=admin123456
