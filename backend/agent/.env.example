# Copy this file to backend/agent/.env and fill in real values.
# This file is mounted into agent container via `--env-file`.

# Required: either this...
KIMI_CODE_API_KEY=your_kimi_api_key_here
# ...or this legacy key name.
# KIMI_API_KEY=your_kimi_api_key_here

# Optional runtime model settings.
# KIMI_MODEL=kimi-for-coding
# KIMI_BASE_URL=https://api.kimi.com/coding/v1
# KIMI_DEFAULT_THINKING=false
# KIMI_DEFAULT_YOLO=true

# Optional: set explicit Kimi CLI binary path inside container.
# Example: /usr/local/bin/kimi
# KIMI_CLI_BIN=/usr/local/bin/kimi

# Optional: set this to prevent Python from writing .pyc files.
PYTHONDONTWRITEBYTECODE=1
